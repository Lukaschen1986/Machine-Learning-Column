# nano_agent — 环境变量模板
# 复制为 .env 并填写实际值

# ── HTTP 服务 ──
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=*

# ── LLM / MaaS（兼容 OpenAI API） ──
LLM_API_BASE=https://maas-api.example.com
LLM_API_KEY=your-maas-api-key
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Agent ──
AGENT_NAME=nano
AGENT_SYS_PROMPT_FILE=AGENTS.md
AGENT_MAX_ITERS=10
AGENT_SKILLS_DIR=skills

# ── 记忆 ──
MEMORY_DIR=memory

# ── MCP ──
MCP_CONFIG_PATH=mcp_config.yaml

# ── 滴滴出行 MCP ──
DIDI_MCP_KEY=your-didi-mcp-key
