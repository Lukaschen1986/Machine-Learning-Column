### model
model_name_or_path: F:/LLM/Qwen/Qwen3.5-0.8B
trust_remote_code: true

### method
stage: sft
do_train: true
finetuning_type: full
#deepspeed: examples/deepspeed/ds_z3_config.json  # 已关闭，Windows兼容

### dataset
dataset: identity
template: qwen3_nothink
cutoff_len: 2048
max_samples: 100000
preprocessing_num_workers: 1  # 默认16，Windows兼容1
dataloader_num_workers: 0  # 默认4，Windows兼容0

### output
output_dir: saves/Qwen3.5-0.8B/full/sft
logging_steps: 10
save_steps: 500
plot_loss: true
overwrite_output_dir: true
save_only_model: false
report_to: none  # choices: [none, wandb, tensorboard, swanlab, mlflow]

### train
per_device_train_batch_size: 2
gradient_accumulation_steps: 2
learning_rate: 0.00001
num_train_epochs: 3.0
lr_scheduler_type: cosine
warmup_ratio: 0.1
bf16: true
ddp_timeout: 180000000
resume_from_checkpoint: null
gradient_checkpointing: false  # 已关闭，Windows兼容

### eval
#eval_dataset: identity  # eval_dataset和val_size二选一
val_size: 0.1
per_device_eval_batch_size: 1
eval_strategy: steps
eval_steps: 500
